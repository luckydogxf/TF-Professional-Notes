# Alibaba Cloud WAF 3.0
export WAF_REGION="ap-southeast-1"
export WAF_INSTANCE_ID="waf_v2_public_REPLACE_ME"

# Get the exact protected-object names with:
#   ./waf-rules.sh resources
#
# Example format:
#   ["example.com-waf","api.example.com-waf"]
export WAF_RESOURCES_JSON='["REPLACE_WITH_PROTECTED_OBJECT-waf"]'

# Optional: choose a different aliyun binary
# export ALIYUN_CLI="aliyun"
